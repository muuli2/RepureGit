  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2018650036}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0dc5104c454eec74396a107ebf3cdadf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NewMonoBehaviourScript
  dialogueManager: {fileID: 1652218907}
  sentences:
  - "???: \u0E17\u0E48\u0E32\u0E19!"
  - "Riniel: \u0E17\u0E48\u0E32\u0E19\u0E21\u0E32\u0E16\u0E36\u0E35\u0E07\u0E40\u0E02\u0E15\u0E19\u0E35\u0E49\u0E44\u0E14\u0E49
    \u0E17\u0E48\u0E32\u0E19\u0E1C\u0E39\u0E49\u0E01\u0E25\u0E49\u0E32\u0E43\u0E0A\u0E48\u0E2B\u0E23\u0E37\u0E2D\u0E44\u0E21\u0E48?
    \u0E02\u0E49\u0E32 Riniel \u0E14\u0E39\u0E41\u0E25\u0E40\u0E02\u0E15\u0E17\u0E30\u0E40\u0E25
    \u0E02\u0E49\u0E32\u0E04\u0E2D\u0E22\u0E01\u0E31\u0E19\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E14\u0E49\u0E32\u0E19\u0E2B\u0E19\u0E49\u0E32"
  - "Riniel: \u0E02\u0E49\u0E32\u0E44\u0E14\u0E49\u0E2A\u0E32\u0E23\u0E08\u0E32\u0E01\u0E17\u0E32\u0E07\u0E40\u0E02\u0E15\u0E2B\u0E25\u0E31\u0E01
    \u0E27\u0E48\u0E32\u0E21\u0E35\u0E1C\u0E39\u0E49\u0E17\u0E35\u0E48\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E1B\u0E23\u0E32\u0E1A\u0E1E\u0E27\u0E01\u0E1B\u0E35\u0E28\u0E32\u0E08\u0E44\u0E14\u0E49
    \u0E40\u0E02\u0E15\u0E2B\u0E25\u0E31\u0E01\u0E1B\u0E25\u0E2D\u0E14\u0E20\u0E31\u0E22\u0E41\u0E25\u0E49\u0E27"
  - "Riniel: \u0E17\u0E48\u0E32\u0E19\u0E2A\u0E38\u0E14\u0E22\u0E2D\u0E14\u0E21\u0E32\u0E01!"
  - "CHOICE: \u0E17\u0E48\u0E32\u0E19\u0E0A\u0E21\u0E40\u0E01\u0E34\u0E19\u0E44\u0E1B\u0E41\u0E25\u0E49\u0E27.."
  - "CHOICE: \u0E02\u0E49\u0E32\u0E21\u0E32\u0E15\u0E32\u0E21\u0E2B\u0E32\u0E40\u0E08\u0E49\u0E32\u0E02\u0E2D\u0E07\u0E42\u0E23\u0E07\u0E40\u0E2B\u0E25\u0E49\u0E32"
  - "CHOICE: \u0E17\u0E48\u0E32\u0E19\u0E17\u0E23\u0E32\u0E1A\u0E44\u0E2B\u0E21\u0E27\u0E48\u0E32\u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u0E40\u0E02\u0E32\u0E2D\u0E22\u0E39\u0E48\u0E17\u0E35\u0E48\u0E44\u0E2B\u0E19?"
  - "Riniel: \u0E17\u0E48\u0E32\u0E19\u0E2B\u0E21\u0E32\u0E22\u0E16\u0E36\u0E07 Barkus
    \u0E2B\u0E23\u0E37\u0E2D? \u0E40\u0E02\u0E32\u0E2D\u0E22\u0E39\u0E48\u0E17\u0E32\u0E07<color=#2CA700>\u0E15\u0E2D\u0E19\u0E40\u0E2B\u0E19\u0E37\u0E2D
    \u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48 Brineveil</color>\u0E19\u0E48\u0E30"
  - "Riniel: \u0E41\u0E15\u0E48\u0E08\u0E30\u0E44\u0E1B Brineveil <color=#2CA700>\u0E15\u0E49\u0E2D\u0E07\u0E1C\u0E48\u0E32\u0E19
    Grimebay </color>\u0E01\u0E48\u0E2D\u0E19"
  - "Riniel: \u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u0E02\u0E49\u0E32\u0E07\u0E43\u0E19\u0E1B\u0E35\u0E28\u0E32\u0E08\u0E0A\u0E38\u0E01\u0E0A\u0E38\u0E21\u0E21\u0E32\u0E01
    \u0E17\u0E48\u0E32\u0E19\u0E23\u0E30\u0E27\u0E31\u0E07\u0E15\u0E31\u0E27\u0E14\u0E49\u0E27\u0E22"
  - "CHOICE: \u0E02\u0E49\u0E32\u0E02\u0E2D\u0E1A\u0E43\u0E08\u0E17\u0E48\u0E32\u0E19\u0E21\u0E32\u0E01
    Riniel"
  upgradeGunAfterDialogue: 0
