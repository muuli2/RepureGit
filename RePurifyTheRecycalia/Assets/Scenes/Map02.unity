  sentences:
  - "\u0E2D\u0E31\u0E31\u0E28\u0E27\u0E34\u0E19\u0E19\u0E30\u0E08\u0E4A\u0E30: \u0E2B\u0E22\u0E38\u0E14\u0E01\u0E48\u0E2D\u0E19!
