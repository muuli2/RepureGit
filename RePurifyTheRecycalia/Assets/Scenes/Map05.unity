  m_Script: {fileID: 11500000, guid: 0dc5104c454eec74396a107ebf3cdadf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NewMonoBehaviourScript
  dialogueManager: {fileID: 1124536399}
  sentences:
  - "\u0E2D\u0E31\u0E31\u0E28\u0E27\u0E34\u0E19\u0E19\u0E30\u0E08\u0E4A\u0E30: \u0E21\u0E32\u0E16\u0E36\u0E07\u0E17\u0E35\u0E48\u0E19\u0E35\u0E48\u0E44\u0E14\u0E49
    \u0E40\u0E08\u0E49\u0E32\u0E19\u0E35\u0E48\u0E44\u0E21\u0E48\u0E18\u0E23\u0E23\u0E21\u0E14\u0E32\u0E08\u0E23\u0E34\u0E07\u0E46"
  - "CHOICE: \u0E17\u0E48\u0E32\u0E19\u0E04\u0E37\u0E2D.."
  - "CHOICE: \u0E16\u0E36\u0E07\u0E44\u0E21\u0E48 \u0E02\u0E49\u0E32\u0E01\u0E47\u0E08\u0E30\u0E40\u0E02\u0E49\u0E32\u0E44\u0E1B
    \u0E40\u0E1E\u0E23\u0E32\u0E30\u0E02\u0E49\u0E32\u0E17\u0E19\u0E14\u0E39\u0E2D\u0E22\u0E39\u0E48\u0E40\u0E09\u0E22\u0E46\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E2B\u0E23\u0E2D\u0E01!\n"
  - "\u0E2D\u0E31\u0E28\u0E27\u0E34\u0E19\u0E19\u0E30\u0E08\u0E4A\u0E30: \u0E41\u0E19\u0E48\u0E27\u0E41\u0E19\u0E48
    \u0E41\u0E25\u0E30\u0E43\u0E08\u0E01\u0E25\u0E49\u0E32\u0E21\u0E32\u0E01"
  - "\u0E2D\u0E31\u0E28\u0E27\u0E34\u0E19\u0E19\u0E30\u0E08\u0E4A\u0E30: \u0E02\u0E49\u0E32\u0E02\u0E2D\u0E41\u0E19\u0E30\u0E19\u0E33
    <color=#006400>\u0E15\u0E32\u0E21\u0E2B\u0E32\u0E1B\u0E49\u0E32\u0E22\u0E20\u0E32\u0E22\u0E43\u0E19\u0E40\u0E21\u0E37\u0E2D\u0E07</color>\u0E43\u0E2B\u0E49\u0E40\u0E08\u0E2D
    \u0E2D\u0E32\u0E08\u0E08\u0E30\u0E0A\u0E48\u0E27\u0E22\u0E17\u0E48\u0E32\u0E19\u0E44\u0E14\u0E49\u0E44\u0E21\u0E48\u0E21\u0E32\u0E01\u0E01\u0E47\u0E19\u0E49\u0E2D\u0E22"
  - "\u0E2D\u0E31\u0E28\u0E27\u0E34\u0E19\u0E19\u0E30\u0E08\u0E4A\u0E30: \u0E02\u0E2D\u0E43\u0E2B\u0E49\u0E42\u0E0A\u0E04\u0E14\u0E35
    \u0E17\u0E48\u0E32\u0E19\u0E1C\u0E39\u0E49\u0E01\u0E25\u0E49\u0E32 \u0E0A\u0E48\u0E27\u0E22\u0E2D\u0E07\u0E04\u0E4C\u0E0A\u0E32\u0E22\u0E21\u0E32\u0E43\u0E2B\u0E49\u0E08\u0E07\u0E44\u0E14\u0E49 "
  upgradeGunAfterDialogue: 1
