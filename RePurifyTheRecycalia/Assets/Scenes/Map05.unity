  - speaker: 1
    speakerName: Lumina
    text: "\u0E2D\u0E07\u0E04\u0E4C\u0E0A\u0E32\u0E22 \u0E17\u0E48\u0E32\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E2D\u0E30\u0E44\u0E23\u0E21\u0E32\u0E01\u0E44\u0E2B\u0E21"
